 BuildAPI←{
     n←ObjectReference.⎕NL ¯2
     t←↑'_'(≠⊆⊢)¨n
     _←'API'##.⎕NS''
     _←{
         o←⍵
         s←⍎⍵ ##.API.⎕NS''
         s.A←#.Abacus.Main
         e←9=s.A.⎕NC o
         m←t[;2]⌿⍨(↓t[;0 1])∊⊂⍵'Method'
         c←⊂'     ⍝ ⍺ ←→ ',⍵,' instance'
         c,←⊂'     ⍝ ⍵ ←→ method argument'
         _←s.⎕FX¨{
             d←'     ⍝ Documentation: #.Abacus.DocSource.ObjectReference.',o,'_Method_',⍵
             (⊂⍵,'←{'),c,d('⍺ A.',(e/o,'.'),⍵,' ⍵')'}'}¨m
         b←(↓t[;0 1])∊⊂⍵'Property'
         v←ObjectReference ⎕VGET b/n
         _←s ⎕VSET(b/t[;2]){⍺ ⍵}¨v
         0
     }¨∪t[;0]
     ⍝ Top-level covers for documented free functions (FunctionReference); the nameclass filter
     ⍝ skips test-suite helpers that RunTests injects and that are not Main functions.
     ##.API.A←#.Abacus.Main
     fn←FunctionReference.⎕NL ¯2
     fn←(3=#.Abacus.Main.⎕NC fn)/fn
     _←##.API.⎕FX¨{
         d←'     ⍝ Documentation: #.Abacus.DocSource.FunctionReference.',⍵
         (⊂⍵,'←{'),(⊂'     ⍺←⊢    ⍝ default ⍺ so a monadic call passes straight through'),(⊂'     ⍝ ⍵ ←→ argument'),d('⍺ A.',⍵,' ⍵')'}'
     }¨fn
     0
 }
